{
  "schemaVersion": 1,
  "id": "com.mdtrr.omadesk",
  "name": "Desks",
  "version": "0.1.0",
  "author": "Christoffer Hallas (Modoterra)",
  "license": "MIT",
  "description": "Workspace manager overlay for Omarchy. See workspaces 1–10 at a glance, jump to one, and move windows between them.",
  "kinds": ["overlay", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "Overlay.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Desks",
    "description": "Opens the Desks overlay.",
    "category": "Work",
    "allowMultiple": false,
    "defaultSection": "left"
  }
}
